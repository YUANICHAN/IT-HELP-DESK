NODE_ENV=development
HOST=127.0.0.1
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/it_help_desk?replicaSet=rs0

# Authentication and browser security
AUTH_COOKIE_NAME=it_help_desk_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://127.0.0.1:5173
AUTH_CSRF_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=168
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_AUDIT_RETENTION_DAYS=180

# SLA evaluator worker
SLA_EVALUATION_INTERVAL_SECONDS=60
SLA_EVALUATION_BATCH_SIZE=200

# Background delivery worker and bounded maintenance
APPLICATION_RELEASE=development
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_CONCURRENCY=4
OUTBOX_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_STALE_SECONDS=30
CLEANUP_INTERVAL_SECONDS=300
CLEANUP_BATCH_SIZE=100
CLEANUP_ABANDONED_UPLOAD_MINUTES=60
IDEMPOTENCY_RETENTION_HOURS=24

# Operations evidence. Keep the manifest outside public directories.
STORAGE_HEALTH_PROBE_ENABLED=true
BACKUP_MANIFEST_PATH=
BACKUP_MAXIMUM_AGE_HOURS=24

# Private file storage. Empty uses repository/private-storage, never a public URL.
ATTACHMENT_STORAGE_ROOT=
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Synthetic seed only permits database it_help_desk_demo_step67.
DEMO_PASSWORD=

# Initial administrator bootstrap - required identity settings
BOOTSTRAP_ORGANIZATION_NAME=Example Organization
BOOTSTRAP_ORGANIZATION_TYPE=COMPANY
BOOTSTRAP_ORGANIZATION_SUPPORT_EMAIL=support@example.com
BOOTSTRAP_DEPARTMENT_CODE=IT
BOOTSTRAP_DEPARTMENT_NAME=Information Technology
BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional bootstrap settings (timezone defaults to Asia/Manila)
BOOTSTRAP_ORGANIZATION_TIMEZONE=Asia/Manila
BOOTSTRAP_ADMIN_EMPLOYEE_NUMBER=
BOOTSTRAP_ADMIN_PHONE=
