NODE_ENV=development
HOST=127.0.0.1
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/it_help_desk

# Authentication and browser security
AUTH_COOKIE_NAME=it_help_desk_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://127.0.0.1:5173
AUTH_CSRF_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=168
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_AUDIT_RETENTION_DAYS=180

# Initial administrator bootstrap - required identity settings
BOOTSTRAP_ORGANIZATION_NAME=Example Organization
BOOTSTRAP_ORGANIZATION_TYPE=COMPANY
BOOTSTRAP_ORGANIZATION_SUPPORT_EMAIL=support@example.com
BOOTSTRAP_DEPARTMENT_CODE=IT
BOOTSTRAP_DEPARTMENT_NAME=Information Technology
BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional bootstrap settings (timezone defaults to Asia/Manila)
BOOTSTRAP_ORGANIZATION_TIMEZONE=Asia/Manila
BOOTSTRAP_ADMIN_EMPLOYEE_NUMBER=
BOOTSTRAP_ADMIN_PHONE=
